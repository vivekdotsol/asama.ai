PORT=4000
PUBLIC_URL=http://localhost:4000

# Persistence: leave empty for in-memory only
DATA_FILE=./data/db.json

# Routing pipeline
VECTOR_TOP_K=50
MAX_NOTIFY=5
MIN_RELEVANCE=0.75

# Optional: use OpenAI embeddings instead of the built-in local embedder
# OPENAI_API_KEY=

# Webhook delivery
DELIVERY_MAX_ATTEMPTS=4
DELIVERY_BACKOFF_MS=500
DELIVERY_TIMEOUT_MS=3000

# Feedback loop
IGNORE_AFTER_MS=86400000

# In production, private/localhost webhook URLs are rejected unless this is true
ALLOW_PRIVATE_WEBHOOKS=true
